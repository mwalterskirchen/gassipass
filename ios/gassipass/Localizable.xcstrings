    "%lld changes are not backed up yet, and they are lost when you sign out. Everything else stays on the server and comes back when you sign in again." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Änderung ist noch nicht gesichert und geht beim Abmelden verloren. Alles andere bleibt auf dem Server und kommt zurück, wenn du dich wieder anmeldest."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Änderungen sind noch nicht gesichert und gehen beim Abmelden verloren. Alles andere bleibt auf dem Server und kommt zurück, wenn du dich wieder anmeldest."
