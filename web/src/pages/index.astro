---
import Layout from "../layouts/Layout.astro";
---

<Layout title="GassiPass">
  <h1 class="mt-6 mb-2 text-[28px] leading-tight font-bold">GassiPass</h1>
  <p class="mb-4">Ein Spiel für Spaziergänge mit dem Hund in der Schweiz.</p>
  <p class="text-[15px] text-ink-muted dark:text-mist">
    Jeder Hund sammelt die Wege, die er geht, bis er ganze Gemeinden und ihre Strassen vollständig hat.
  </p>
</Layout>
