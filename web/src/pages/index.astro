---
import Layout from "../layouts/Layout.astro";
---

<Layout title="GassiPass">
  <h1 class="mt-6 mb-2 text-[28px] leading-tight font-bold">GassiPass</h1>
  <p class="mb-4">Sammle mit deinem Hund jede Strasse deiner Gemeinde.</p>
  <p class="text-[15px] text-ink-muted dark:text-mist">
    GassiPass zeichnet eure Spaziergänge auf und merkt sich jeden Weg, den dein Hund schon gegangen ist. So
    siehst du, welche Strassen noch fehlen, bis deine Gemeinde abgeschlossen ist.
  </p>
</Layout>
