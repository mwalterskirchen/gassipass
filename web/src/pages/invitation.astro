---
import Layout from "../layouts/Layout.astro";

// vercel.json rewrites each /invitation/<token> to this page (/invitation). The page shows only when the link
// does not open the app, so it never reads the token.

// TODO: Replace the placeholder with the public TestFlight link.
const testFlightURL = "https://testflight.apple.com/join/PLACEHOLDER";
---

<Layout title="Einladung ins Rudel · GassiPass" noindex>
  <h1 class="mt-6 mb-2 text-[28px] leading-tight font-bold">Einladung ins Rudel</h1>
  <p class="mb-4">Du bist in ein Rudel bei GassiPass eingeladen.</p>
  <p class="mb-4 text-[15px] text-ink-muted dark:text-mist">
    Öffne diesen Link auf einem iPhone, auf dem GassiPass installiert ist. Tippe ihn zum Beispiel in WhatsApp
    oder in Nachrichten an. Die App öffnet sich dann und zeigt dir die Einladung.
  </p>

  <section
    class="mt-8 mb-6 rounded-2xl border border-sand bg-paper px-5 py-6 dark:border-night-edge dark:bg-night-raised"
  >
    <h2 class="mb-2 text-[19px] font-bold">Du hast GassiPass noch nicht?</h2>
    <p class="mb-4 text-[15px] text-ink-muted dark:text-mist">
      GassiPass ist im Moment in der Testphase. Installiere die App über TestFlight, und tippe danach noch
      einmal auf den Link der Einladung.
    </p>
    <a
      class="mt-2 inline-block rounded-full bg-forest px-6 py-3.5 font-semibold text-cream no-underline dark:bg-forest-light"
      href={testFlightURL}>GassiPass in TestFlight</a
    >
  </section>

  <p class="text-[15px] text-ink-muted dark:text-mist">Eine Einladung gilt 7 Tage und nur für eine Person.</p>
</Layout>
