{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/invitation/:path*",
      "destination": "/invitation"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
